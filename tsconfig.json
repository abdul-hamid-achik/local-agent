{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "customConditions": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Only to type-check @thelacanians/tuimark, whose `bun` export condition points
    // at .ts sources that import each other with extensions. noEmit, so harmless;
    // drop it if the SDK ships usable types for the `bun` condition.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "specs/**/*.ts",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.mts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
