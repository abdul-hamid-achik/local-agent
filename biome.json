{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**/*.ts",
      "apps/**/package.json",
      "packages/**/*.ts",
      "packages/**/package.json",
      "scripts/**/*.ts",
      "specs/**/*.ts",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "vitest.config.ts",
      "vitest.setup.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
