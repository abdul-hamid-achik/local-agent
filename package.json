{
  "name": "local-agent-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ],
  "engines": {
    "node": ">=22",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun run apps/cli/src/main.ts",
    "start": "bun run apps/cli/dist/main.mjs",
    "build": "bun run --cwd apps/cli build && bun run tui:build",
    "typecheck": "tsc --noEmit && bun run --cwd apps/tui-playground typecheck && bun run --cwd apps/desktop typecheck",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build",
    "test": "bun --bun vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "site": "bun run --cwd docs dev",
    "site:build": "bun run --cwd docs build",
    "site:preview": "bun run --cwd docs preview",
    "test:watch": "bun --bun vitest",
    "tuimark:check": "bun apps/cli/src/tuimark/check.ts",
    "tui:dev": "bun run --cwd apps/tui-playground dev",
    "tui:build": "bun run --cwd apps/tui-playground build",
    "test:integration": "glyph run specs/bun/*.yml --parallel 1 --format md --progress never",
    "test:integration:tuimark": "glyph run specs/tuimark/*.yml --parallel 1 --format md --progress never",
    "site:check-links": "bun scripts/site-links.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.2",
    "entities": "7.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
