<!--
  local-agent, fullscreen client on Tuimark (the default client on macOS and Linux).

  The store this document reads is built by ../store.ts; every flag is always
  present because the markup has no equality test. Actions are implemented by
  ../controller.ts. The kit (kit/) is vendored from Tuimark v0.4.5, unmodified.
  Needs tuimark 0.4.6: <textarea> and the append write.

  Cards are templates:
    la-message  props label; slot: the body            (user and assistant)
    la-tool     with="card as t"; slot: the output     (tool call)
    la-blocks   with="blocks as blocks": markdown blocks (text runs) and code
    la-turn     with="msg": one message of the transcript, history or live
  The approval dialog is the kit's k-confirm, its slot holding the diff.
-->
<tui theme="auto" mouse="mouse_on">
  <include src="kit/kit.tui"/>
  <style src="app.tcss"/>

  <!-- The palette's arrows move its list while the input keeps focus. -->
  <keymap when=".k-palette">
    <bind keys="down,ctrl+n" action="move-next" to="#palette__list"/>
    <bind keys="up,ctrl+p" action="move-prev" to="#palette__list"/>
  </keymap>
  <!-- The approval preview: every row of what is being approved is reachable by
       key while the dialog is open (focus stays on Deny). -->
  <keymap when=".k-dialog">
    <!-- Allow this call and matching ones for the session (the dialog's
         grant line spells out what matches). The kit's own dialog rows
         (y/n) are fixed, so `a` is this document's row, like scroll. -->
    <bind keys="a" action="dialog_session" label="session" keycap="a"/>
    <bind keys="pgup" action="move-page-up" to="#approval_diff" label="scroll" keycap="pgup/pgdn"/>
    <bind keys="pgdn" action="move-page-down" to="#approval_diff"/>
    <bind keys="up" action="move-prev" to="#approval_diff"/>
    <bind keys="down" action="move-next" to="#approval_diff"/>
    <bind keys="home" action="move-first" to="#approval_diff" label="top/end" keycap="home/end"/>
    <bind keys="end" action="move-last" to="#approval_diff"/>
  </keymap>
  <!-- The details viewer's keys, while its modal is open: every row of
       the output is reachable by key, and q closes it like esc (the
       modal's on:escape). No labels: the viewer names its own keys. -->
  <keymap when=".la-details">
    <bind keys="q" action="details_close"/>
    <bind keys="pgup" action="move-page-up" to="#details_body"/>
    <bind keys="pgdn" action="move-page-down" to="#details_body"/>
    <bind keys="up" action="move-prev" to="#details_body"/>
    <bind keys="down" action="move-next" to="#details_body"/>
    <bind keys="home" action="move-first" to="#details_body"/>
    <bind keys="end" action="move-last" to="#details_body"/>
  </keymap>
  <!-- The sessions picker's keys, while the panel modal is picking (the
       modal carries the class): up and down move the parent's choice and
       enter loads it. Before the panel's scroll rows below, so the arrows
       are the picker's, not the scroll's. -->
  <keymap when=".picking">
    <bind keys="down" action="panel_next"/>
    <bind keys="up" action="panel_prev"/>
    <bind keys="enter" action="panel_run"/>
  </keymap>
  <!-- The read-only panel's keys, while its modal is open: like the
       details viewer's (every row reachable, q closes like esc). -->
  <keymap when=".la-panel">
    <bind keys="q" action="panel_close"/>
    <bind keys="pgup" action="move-page-up" to="#panel_body"/>
    <bind keys="pgdn" action="move-page-down" to="#panel_body"/>
    <bind keys="up" action="move-prev" to="#panel_body"/>
    <bind keys="down" action="move-next" to="#panel_body"/>
    <bind keys="home" action="move-first" to="#panel_body"/>
    <bind keys="end" action="move-last" to="#panel_body"/>
  </keymap>
  <!-- The slash popup's keys, while it is open (the screen carries the
       class): they stand before the history and cancel rows below, and
       dispatch takes the first row that matches, so up and down move the
       popup's choice and esc closes it instead of cancelling a turn. No
       labels: the popup names its own keys, like the kit's overlays. -->
  <keymap when=".slashpop">
    <bind keys="down" action="slash_next"/>
    <bind keys="up" action="slash_prev"/>
    <bind keys="tab" action="slash_complete"/>
    <bind keys="esc" action="slash_close"/>
  </keymap>
  <keymap>
    <!-- Hint order is keymap order: commands first, so it is the one hint a
         narrow terminal still shows (the first that does not fit drops the rest). -->
    <bind keys="ctrl+p" action="palette_open" keycap="^P" label="commands"/>
    <bind keys="esc" action="cancel" label="cancel"/>
    <!-- Not the built-in `quit` (the engine runs that itself and the parent
         never sees it): the parent's handler clears a draft first, then quits. -->
    <bind keys="ctrl+c" action="quit_request" label="quit"/>
    <!-- The composer takes up and down inside a draft; on its first and last line
         they fall through to these rows, which recall what was sent. -->
    <bind keys="up" action="history_prev" when="#composer:focus" label="history" keycap="↑/↓"/>
    <bind keys="down" action="history_next" when="#composer:focus"/>
    <bind keys="ctrl+o" action="load_earlier" keycap="^O" label="earlier"/>
    <bind keys="pgup" action="move-page-up" to="#log" label="scroll" keycap="pgup/pgdn"/>
    <bind keys="pgdn" action="move-page-down" to="#log"/>
    <!-- Jump back to the newest message (and re-stick the log). `end` cannot do
         this: the composer takes end/ctrl+e for its own caret, and ctrl+end is
         not a key token. ctrl+l reaches the keymap from the composer. -->
    <bind keys="ctrl+l" action="move-last" to="#log" keycap="^L" label="latest"/>
    <!-- Plan <-> build. The composer does not take shift+tab, and a legacy
         terminal sends it as one key (CSI Z), so the row fires with or
         without the kitty keyboard protocol. -->
    <bind keys="shift+tab" action="mode_toggle" keycap="shift+tab" label="mode"/>
  </keymap>
  <!-- A modal traps the keymap: what must also work under one is repeated here. -->
  <keymap when="modal">
    <bind keys="ctrl+c" action="quit_request"/>
  </keymap>

  <!-- One message, user or assistant. Props: label. Slot: the body. The variant
       (a static class on the use) colors the label. -->
  <template id="la-message" props="label">
    <col class="la-msg">
      <text class="la-role">{$label}</text>
      <slot/>
    </col>
  </template>

  <!-- The markdown blocks of a message. with="msg.blocks as blocks". Text is
       runs (inline marks, styled by span.* in app.tcss); a code block is one
       pre-wrap text whose runs are the syntax tokens. -->
  <template id="la-blocks">
    <col class="la-blocks" each="blocks as b" key="b.id">
      <text if="b.para" runs="b.runs" wrap="wrap"/>
      <text if="b.head" class="la-head" runs="b.runs" wrap="wrap"/>
      <text if="b.quote" class="la-quote" runs="b.runs" wrap="wrap"/>
      <row if="b.item" class="la-item" class:nest="b.nest">
        <text class="la-marker">{b.marker}</text>
        <text class="la-itemtext" runs="b.runs" wrap="wrap"/>
      </row>
      <col if="b.code" class="la-code">
        <text class="la-lang">{b.lang}</text>
        <text class="la-codetext" runs="b.runs" wrap="pre-wrap"/>
      </col>
    </col>
  </template>

  <!-- A tool call. with="msg.card as t". Slot: the output lines. -->
  <template id="la-tool">
    <box class="la-tool" class:ok="t.ok" class:bad="t.bad" class:warn="t.warn" class:run="t.running" title="Tool · {t.name}">
      <row class="la-tool-head">
        <progress indeterminate="true" if="t.running" class="la-spin"/>
        <text class="la-tool-status">{t.status}</text>
      </row>
      <text if="t.args" class="la-muted" wrap="truncate">{t.args}</text>
      <slot/>
    </box>
  </template>

  <!-- One message of the transcript. The history rows and the in-flight message
       share it. with="message as msg". -->
  <template id="la-turn">
    <use template="la-message" label="You" class="user" if="msg.is_user">
      <use template="la-blocks" with="msg.blocks as blocks"/>
    </use>
    <use template="la-message" label="Assistant" class="asst" if="msg.is_asst">
      <use template="la-blocks" with="msg.blocks as blocks"/>
    </use>
    <use template="la-tool" if="msg.is_tool" with="msg.card as t">
      <text class="la-out" runs="msg.card.out" wrap="pre-wrap"/>
    </use>
    <!-- A UI-local notice (a failed turn's error): the client's words, never the model's. -->
    <use template="la-message" label="Error" class="notice" if="msg.is_notice">
      <use template="la-blocks" with="msg.blocks as blocks"/>
    </use>
  </template>

  <screen id="main" focus="#composer" class:slashpop="slash.open">
    <col id="app">
      <use template="k-appbar" brand="Local Agent" title="">
        <text class="la-muted la-provider">{header.provider}</text>
        <text class="la-model">{header.model}</text>
        <text class="la-mode">{header.mode}</text>
        <spacer/>
        <text if="header.grants_on" class="la-muted la-grants">{header.grants}</text>
        <text class="la-muted la-session">{header.session}</text>
        <text class="la-muted la-ctx" class:warn="header.ctx_warn" class:danger="header.ctx_danger">ctx {header.ctx_label}</text>
        <progress id="ctx" class="la-ctxbar" class:warn="header.ctx_warn" class:danger="header.ctx_danger" bind="header.ctx_pct"/>
      </use>

      <scroll id="log" stick="bottom" focusable="true">
        <!-- The welcome, only before the first message (`empty` is latched off
             by the parent and never returns). Facts come from the header the
             appbar already shows; the tips name keys that exist. -->
        <use template="k-empty" if="empty" title="Local Agent" style="height: auto">
          <text class="la-welcome-line" wrap="wrap">{header.model} · {header.provider}</text>
          <text class="la-welcome-line" wrap="wrap">{header.mode} · {header.session}</text>
          <text class="la-welcome-line" wrap="wrap">{header.workspace}</text>
          <text class="la-welcome-line" wrap="wrap">/help lists keys</text>
          <text class="la-welcome-line" wrap="wrap">ctrl+p opens commands</text>
          <text class="la-welcome-line" wrap="wrap">esc cancels a turn</text>
        </use>
        <button id="earlier" class="la-earlier" if="earlier.n" on:click="load_earlier">▲ {earlier.n} earlier messages, ctrl+o or enter to load more</button>
        <col id="rows" each="messages as m" key="m.id">
          <use template="la-turn" with="m as msg"/>
        </col>
        <!-- The in-flight message. A reply is live.blocks (final, appended to) and
             live.tail (the block being written); a tool call is live.card. -->
        <col id="live" if="live.active">
          <use template="la-message" label="Assistant" class="asst" if="live.is_asst">
            <use template="la-blocks" with="live.blocks as blocks"/>
            <use template="la-blocks" with="live.tail as blocks"/>
          </use>
          <use template="la-tool" if="live.is_tool" with="live.card as t">
            <text class="la-out" runs="live.card.out" wrap="pre-wrap"/>
          </use>
        </col>
        <!-- The model's reasoning, dim, until the answer starts: the stream appends to
             thinking.runs and the scroll shows the last three rows of it. -->
        <col id="thinking" if="thinking.on">
          <text class="la-think-head">Thinking…</text>
          <scroll id="think" class="la-thinkbox" stick="bottom">
            <text class="la-think" runs="thinking.runs" wrap="pre-wrap"/>
          </scroll>
        </col>
      </scroll>

      <!-- The slash popup: display-only rows over the composer while the
           draft is a half-typed command. The parent keeps slash.rows from
           the composer's edits; nothing here can take focus. -->
      <col id="slashpop" class="la-slashpop" if="slash.open">
        <col class="la-slash-rows" each="slash.rows as r" key="r.id">
          <row class="la-slash-row" class:sel="r.sel">
            <text class="la-slash-mark">{r.mark}</text>
            <text class="la-slash-cmd">{r.cmd}</text>
            <text class="la-slash-desc">{r.desc}</text>
          </row>
        </col>
        <text class="la-slash-foot">up/down choose · tab complete · enter completes or runs · esc close</text>
      </col>

      <!-- enter sends; shift+enter, alt+enter and a pasted block keep their line breaks.
           on:change carries every edit, which is what opens the popup above. -->
      <textarea id="composer" bind="draft" placeholder="{placeholder}" on:change="typed" on:submit="send"/>

      <row id="status" class="k-statusbar">
        <progress indeterminate="true" if="busy" class="la-spin"/>
        <text class="la-statustext" wrap="truncate">{status}</text>
        <hints class="la-hints"/>
      </row>
    </col>

    <use id="approval" template="k-confirm" style="width: 76; max-width: 100%" with="approval as d">
      <scroll id="approval_diff" class="la-diff" focusable="true">
        <col class="la-difflines" each="approval.lines as ln" key="ln.n">
          <text wrap="truncate" class:add="ln.add" class:del="ln.del" class:note="ln.note">{ln.t}</text>
        </col>
      </scroll>
      <!-- What `a` would grant for the session, or why it cannot. -->
      <text class="la-muted la-granthint">{approval.grant_hint}</text>
    </use>
    <use id="palette" template="k-palette" title="Commands" placeholder="type a command…" with="palette as p, found as f"/>
    <!-- The help overlay. The kit's k-help lists keys only and takes no
         slot, so the overlay is written here with its classes: the slash
         commands (help.cmds, from the one catalog in ../commands.ts),
         then every labeled key. The kit's .k-help rows (q, ?) and
         on:escape close it. The composer's own enter keys are plain rows:
         no keymap row can name them (the composer takes them first). -->
    <modal id="help_dialog" class="k-help" open="help.open" title="Help" on:escape="help_close">
      <row class="k-help-close">
        <text class="k-help-key">?</text>
        <text class="k-help-label">close help</text>
      </row>
      <text class="la-help-head">Commands</text>
      <col class="la-helpcmds" each="help.cmds as c" key="c.id">
        <row class="la-helpcmd">
          <text class="la-helpcmd-key">{c.cmd}</text>
          <text class="la-helpcmd-desc">{c.desc}</text>
        </row>
      </col>
      <text class="la-help-head">Keys</text>
      <scroll id="help_keys" class="k-help-scroll" focusable="true">
        <row class="la-helpcmd">
          <text class="la-helpcmd-key">enter</text>
          <text class="la-helpcmd-desc">send</text>
        </row>
        <row class="la-helpcmd">
          <text class="la-helpcmd-key">shift/alt+enter</text>
          <text class="la-helpcmd-desc">new line</text>
        </row>
        <hints class="k-hints k-help-keys" scope="all"/>
      </scroll>
    </modal>
    <!-- The details viewer: the latest tool receipt's output in full
         (/details). An app-level modal like the help above, with kit
         classes; the parent hard-wraps the rows (details.lines) at the
         dialog's width, like an approval preview. -->
    <modal id="details_dialog" class="la-details" open="details.open" title="{details.title}" focus="#details_body" on:escape="details_close">
      <text if="details.args" class="la-muted" wrap="truncate">{details.args}</text>
      <scroll id="details_body" class="la-diff" focusable="true">
        <col class="la-difflines" each="details.lines as ln" key="ln.n">
          <text wrap="truncate" class:note="ln.note">{ln.t}</text>
        </col>
      </scroll>
      <text class="la-muted">pgup/pgdn scroll · home/end top/bottom · esc or q close</text>
    </modal>
    <!-- The read-only panel: /status and /mcp as wrapped lines, /sessions
         as picker rows (panel.rows; the parent moves the choice, nothing
         in an each can take focus). The details viewer's modal shape. -->
    <modal id="panel_dialog" class="la-panel" class:picking="panel.picking" open="panel.open" title="{panel.title}" on:escape="panel_close">
      <text if="panel.args" class="la-muted" wrap="truncate">{panel.args}</text>
      <!-- Not focusable (unlike the details scroll): a focused scroll
           takes the arrows itself, and the picker's choice must get
           them. The keymap scrolls it by target instead. -->
      <scroll id="panel_body" class="la-diff" focusable="false">
        <col class="la-difflines" each="panel.lines as ln" key="ln.n">
          <text wrap="truncate" class:note="ln.note">{ln.t}</text>
        </col>
        <col class="la-slash-rows" each="panel.rows as r" key="r.id">
          <row class="la-slash-row" class:sel="r.sel">
            <text class="la-slash-mark">{r.mark}</text>
            <text class="la-panel-label">{r.label}</text>
          </row>
        </col>
      </scroll>
      <text if="panel.picking" class="la-muted">up/down choose · enter loads · pgup/pgdn scroll · esc close</text>
      <text if="!panel.picking" class="la-muted">pgup/pgdn scroll · home/end top/bottom · esc or q close</text>
    </modal>
  </screen>
</tui>
