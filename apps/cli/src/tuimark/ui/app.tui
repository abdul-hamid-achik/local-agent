<!--
  local-agent, fullscreen client on Tuimark (the default client on macOS and Linux).

  The store this document reads is built by ../store.ts; every flag is always
  present because the markup has no equality test. Actions are implemented by
  ../controller.ts. The kit (kit/) is vendored from Tuimark v0.4.5, unmodified.
  Needs tuimark 0.4.6: <textarea> and the append write.

  Cards are templates:
    la-message  props label; slot: the body            (user and assistant)
    la-tool     with="card as t"; slot: the output     (tool call)
    la-blocks   with="blocks as blocks": markdown blocks (text runs) and code
    la-turn     with="msg": one message of the transcript, history or live
  The approval dialog is the kit's k-confirm, its slot holding the diff.
-->
<tui theme="auto" mouse="mouse_on">
  <include src="kit/kit.tui"/>
  <style src="app.tcss"/>

  <!-- The palette's arrows move its list while the input keeps focus. -->
  <keymap when=".k-palette">
    <bind keys="down,ctrl+n" action="move-next" to="#palette__list"/>
    <bind keys="up,ctrl+p" action="move-prev" to="#palette__list"/>
  </keymap>
  <!-- The approval preview: every row of what is being approved is reachable by
       key while the dialog is open (focus stays on Deny). -->
  <keymap when=".k-dialog">
    <bind keys="pgup" action="move-page-up" to="#approval_diff" label="scroll" keycap="pgup/pgdn"/>
    <bind keys="pgdn" action="move-page-down" to="#approval_diff"/>
    <bind keys="up" action="move-prev" to="#approval_diff"/>
    <bind keys="down" action="move-next" to="#approval_diff"/>
    <bind keys="home" action="move-first" to="#approval_diff" label="top/end" keycap="home/end"/>
    <bind keys="end" action="move-last" to="#approval_diff"/>
  </keymap>
  <keymap>
    <!-- Hint order is keymap order: commands first, so it is the one hint a
         narrow terminal still shows (the first that does not fit drops the rest). -->
    <bind keys="ctrl+p" action="palette_open" keycap="^P" label="commands"/>
    <bind keys="esc" action="cancel" label="cancel"/>
    <bind keys="ctrl+c" action="quit" label="quit"/>
    <!-- The composer takes up and down inside a draft; on its first and last line
         they fall through to these rows, which recall what was sent. -->
    <bind keys="up" action="history_prev" when="#composer:focus" label="history" keycap="↑/↓"/>
    <bind keys="down" action="history_next" when="#composer:focus"/>
    <bind keys="ctrl+o" action="load_earlier" keycap="^O" label="earlier"/>
    <bind keys="pgup" action="move-page-up" to="#log" label="scroll" keycap="pgup/pgdn"/>
    <bind keys="pgdn" action="move-page-down" to="#log"/>
    <!-- Jump back to the newest message (and re-stick the log). `end` cannot do
         this: the composer takes end/ctrl+e for its own caret, and ctrl+end is
         not a key token. ctrl+l reaches the keymap from the composer. -->
    <bind keys="ctrl+l" action="move-last" to="#log" keycap="^L" label="latest"/>
    <!-- The keys the composer itself takes. It consumes them before the keymap, so
         these rows never fire: they are here so that the help lists them, and
         `when` keeps them out of the status line. -->
    <bind keys="enter" action="focus" to="#composer" when="#composer:focus" label="send" keycap="enter"/>
    <bind keys="shift+enter,alt+enter" action="focus" to="#composer" when="#composer:focus" label="new line" keycap="shift/alt+enter"/>
  </keymap>
  <!-- A modal traps the keymap: what must also work under one is repeated here. -->
  <keymap when="modal">
    <bind keys="ctrl+c" action="quit"/>
  </keymap>

  <!-- One message, user or assistant. Props: label. Slot: the body. The variant
       (a static class on the use) colors the label. -->
  <template id="la-message" props="label">
    <col class="la-msg">
      <text class="la-role">{$label}</text>
      <slot/>
    </col>
  </template>

  <!-- The markdown blocks of a message. with="msg.blocks as blocks". Text is
       runs (inline marks, styled by span.* in app.tcss); a code block is one
       pre-wrap text whose runs are the syntax tokens. -->
  <template id="la-blocks">
    <col class="la-blocks" each="blocks as b" key="b.id">
      <text if="b.para" runs="b.runs" wrap="wrap"/>
      <text if="b.head" class="la-head" runs="b.runs" wrap="wrap"/>
      <text if="b.quote" class="la-quote" runs="b.runs" wrap="wrap"/>
      <row if="b.item" class="la-item" class:nest="b.nest">
        <text class="la-marker">{b.marker}</text>
        <text class="la-itemtext" runs="b.runs" wrap="wrap"/>
      </row>
      <col if="b.code" class="la-code">
        <text class="la-lang">{b.lang}</text>
        <text class="la-codetext" runs="b.runs" wrap="pre-wrap"/>
      </col>
    </col>
  </template>

  <!-- A tool call. with="msg.card as t". Slot: the output lines. -->
  <template id="la-tool">
    <box class="la-tool" class:ok="t.ok" class:bad="t.bad" class:warn="t.warn" class:run="t.running" title="Tool · {t.name}">
      <row class="la-tool-head">
        <progress indeterminate="true" if="t.running" class="la-spin"/>
        <text class="la-tool-status">{t.status}</text>
      </row>
      <text if="t.args" class="la-muted" wrap="truncate">{t.args}</text>
      <slot/>
    </box>
  </template>

  <!-- One message of the transcript. The history rows and the in-flight message
       share it. with="message as msg". -->
  <template id="la-turn">
    <use template="la-message" label="You" class="user" if="msg.is_user">
      <use template="la-blocks" with="msg.blocks as blocks"/>
    </use>
    <use template="la-message" label="Assistant" class="asst" if="msg.is_asst">
      <use template="la-blocks" with="msg.blocks as blocks"/>
    </use>
    <use template="la-tool" if="msg.is_tool" with="msg.card as t">
      <text class="la-out" runs="msg.card.out" wrap="pre-wrap"/>
    </use>
  </template>

  <screen id="main" focus="#composer">
    <col id="app">
      <use template="k-appbar" brand="Local Agent" title="">
        <text class="la-muted la-provider">{header.provider}</text>
        <text class="la-model">{header.model}</text>
        <text class="la-mode">{header.mode}</text>
        <spacer/>
        <text class="la-muted la-session">{header.session}</text>
        <text class="la-muted la-ctx">ctx {header.ctx_label}</text>
        <progress id="ctx" class="la-ctxbar" bind="header.ctx_pct"/>
      </use>

      <scroll id="log" stick="bottom" focusable="true">
        <!-- The welcome, only before the first message (`empty` is latched off
             by the parent and never returns). Facts come from the header the
             appbar already shows; the tips name keys that exist. -->
        <use template="k-empty" if="empty" title="Local Agent" style="height: auto">
          <text class="la-welcome-line" wrap="wrap">{header.model} · {header.provider}</text>
          <text class="la-welcome-line" wrap="wrap">{header.mode} · {header.session}</text>
          <text class="la-welcome-line" wrap="wrap">{header.workspace}</text>
          <text class="la-welcome-line" wrap="wrap">/help lists keys</text>
          <text class="la-welcome-line" wrap="wrap">ctrl+p opens commands</text>
          <text class="la-welcome-line" wrap="wrap">esc cancels a turn</text>
        </use>
        <button id="earlier" class="la-earlier" if="earlier.n" on:click="load_earlier">▲ {earlier.n} earlier messages, ctrl+o or enter to load more</button>
        <col id="rows" each="messages as m" key="m.id">
          <use template="la-turn" with="m as msg"/>
        </col>
        <!-- The in-flight message. A reply is live.blocks (final, appended to) and
             live.tail (the block being written); a tool call is live.card. -->
        <col id="live" if="live.active">
          <use template="la-message" label="Assistant" class="asst" if="live.is_asst">
            <use template="la-blocks" with="live.blocks as blocks"/>
            <use template="la-blocks" with="live.tail as blocks"/>
          </use>
          <use template="la-tool" if="live.is_tool" with="live.card as t">
            <text class="la-out" runs="live.card.out" wrap="pre-wrap"/>
          </use>
        </col>
        <!-- The model's reasoning, dim, until the answer starts: the stream appends to
             thinking.runs and the scroll shows the last three rows of it. -->
        <col id="thinking" if="thinking.on">
          <text class="la-think-head">Thinking…</text>
          <scroll id="think" class="la-thinkbox" stick="bottom">
            <text class="la-think" runs="thinking.runs" wrap="pre-wrap"/>
          </scroll>
        </col>
      </scroll>

      <!-- enter sends; shift+enter, alt+enter and a pasted block keep their line breaks. -->
      <textarea id="composer" bind="draft" placeholder="{placeholder}" on:submit="send"/>

      <row id="status" class="k-statusbar">
        <progress indeterminate="true" if="busy" class="la-spin"/>
        <text class="la-statustext" wrap="truncate">{status}</text>
        <hints class="la-hints"/>
      </row>
    </col>

    <use id="approval" template="k-confirm" style="width: 76; max-width: 100%" with="approval as d">
      <scroll id="approval_diff" class="la-diff" focusable="true">
        <col class="la-difflines" each="approval.lines as ln" key="ln.n">
          <text wrap="truncate" class:add="ln.add" class:del="ln.del" class:note="ln.note">{ln.t}</text>
        </col>
      </scroll>
    </use>
    <use id="palette" template="k-palette" title="Commands" placeholder="type a command…" with="palette as p, found as f"/>
    <use id="help" template="k-help" title="Keys" with="help as h"/>
  </screen>
</tui>
