/* local-agent's own styling, loaded after the kit (kit/theme.tcss, kit/kit.tcss).
 * Tokens come from the kit; the syntax colors are this file's. The kit
 * tokens re-declared here are the ones that miss 4.5:1 on bg, panel, raised
 * or sel; muted moves with subtle so the two still rank (themes.test.ts).
 * Text that carries content is never dim: a terminal renders dim as it likes,
 * so no contrast check can see it. */
:root {
  --muted: #939ca5;
  --subtle: #8a929c;
  --danger: #f85c55;

  --kw: #ff7b72;
  --str: #a5d6ff;
  --num: #79c0ff;
  --com: #8b949e;
  --user: #3fb950;
  --tool: #d29922;
}
@media (theme: light) {
  :root {
    /* The kit's light muted, again: the dark one above would win otherwise. */
    --muted: #59636e;
    --subtle: #626b78;
    --accent: #0967d5;
    --ok: #197a35;
    --warn: #916100;
    --danger: #ce232e;
    --code: #7d49de;

    --kw: #cf222e;
    --str: #0a3069;
    --num: #0550ae;
    --com: #636b74;
    --user: #197a35;
    --tool: #916100;
  }
}

#app { layout: column; width: 1fr; height: 1fr; }
.la-muted { color: $muted; }
/* Sources and images ride the transcript width: an img sized in cells
   would clip on a narrow column, so it fills its container instead. */
.la-image > img { width: 100%; height: auto; }
.la-sources { gap: 0; }
.la-model { bold: true; width: auto; }
.la-mode { color: $warn; width: auto; }
.la-sandbox { color: $ok; width: auto; }
.la-goal { color: $accent; width: auto; }
.la-provider, .la-locality, .la-session, .la-ctx, .la-grants { width: auto; }
/* Where the prompt goes is in the appbar at every width: the provider
 * label says it on a wide terminal, LOCAL or REMOTE in its place below
 * 111 columns, and in the compact tier the model name gives way to it. */
.la-locality { color: $muted; }
.la-locality.remote { color: $accent; bold: true; }
@media (min-cols: 111) {
  .la-locality { display: none; }
}
@media (max-cols: 110) {
  .la-provider { display: none; }
}
@media (max-cols: 60) {
  .la-model { display: none; }
}
/* The grants label is long: the session id and then the ctx bar (the
 * label keeps the numbers) give it room before the ctx label is cut. */
@media (max-cols: 130) {
  .la-session.crowded { display: none; }
}
@media (max-cols: 90) {
  .la-ctxbar.crowded { display: none; }
  .la-session { display: none; }
}
/* Eighths: the meter moves by an eighth of a cell, not a whole one. */
.la-ctxbar { width: 12; bar: eighths; }
/* Ctx thresholds (store flags: warn at >=75%, danger at >=90%; danger wins). */
.la-ctx.warn, .la-ctxbar.warn { color: $warn; }
.la-ctx.danger, .la-ctxbar.danger { color: $danger; }
.la-spin, .la-still { width: 2; }
.la-still { color: $muted; }

/* Bordered like the composer and the diff, so `scrollbar: auto` has a right
 * border to paint its thumb over (a borderless viewport gets none). */
#log { width: 1fr; height: 1fr; border: single; border-color: $border; padding: 0 1; scrollbar: auto; }
#log:focus { border: double; border-color: $focus; }
.la-welcome { height: auto; layout: column; margin: 0 0 1 0; }
.la-welcome-title { bold: true; width: auto; }
.la-welcome-line { width: auto; color: $muted; }
#rows, #live { height: auto; layout: column; }

.la-msg { height: auto; layout: column; margin: 0 0 1 0; }
.la-role { bold: true; }
.la-msg.user > .la-role { color: $user; }
.la-msg.asst > .la-role { color: $accent; }
.la-msg.error > .la-role { color: $danger; }
.la-msg.notice > .la-role { color: $warn; }
/* The reply being written: its label, a spinner (or a still glyph while the
 * turn waits on you) and the phase with the elapsed time, dim (app.tui #live). */
.la-live-head { height: 1; gap: 1; }
.la-live-head > .la-role { width: auto; color: $accent; }
.la-live-text { width: 1fr; }
.la-blocks { height: auto; layout: column; }
.la-blocks > text { wrap: wrap; }
/* Prose stops at a readable measure on a wide terminal; code blocks and
 * tool output keep the whole width. */
.la-blocks > text, .la-item { max-width: 100; }
.la-head { bold: true; }
.la-quote { color: $muted; italic: true; padding: 0 0 0 1; }
.la-item { height: auto; layout: row; gap: 1; }
.la-item.nest { padding: 0 0 0 2; }
.la-marker { width: auto; color: $muted; }
.la-itemtext { width: 1fr; }

.la-code { height: auto; layout: column; background: $panel; padding: 0 1; }
/* A table has no label row to set it off from a table or code block above. */
.la-code.table { margin: 1 0 0 0; }
.la-lang { color: $muted; }
.la-codetext, .la-out, .la-think { height: auto; }
.la-think { padding: 0 0 0 2; color: $muted; italic: true; }
.la-thinkbox { height: auto; max-height: 3; width: 1fr; }

/* Inline runs (blocks.ts inlineRuns) and code tokens: a span is styled by the
 * class its run carries. */
span.b { bold: true; }
span.i { italic: true; }
span.code { color: $code; }
span.link { underline: true; color: $accent; }
span.url { color: $muted; }
span.strike { dim: true; }
span.kw { color: $kw; }
span.str { color: $str; }
span.num { color: $num; }
span.think { color: $muted; italic: true; }
span.com, span.note { color: $com; italic: true; }
span.err { color: $danger; bold: true; }
/* The change an edit made, on its card (blocks.ts changeRows). */
span.add { color: $ok; }
span.del { color: $danger; }

.la-tool { height: auto; layout: column; border: rounded; border-color: $border; title-color: $tool; padding: 0 1; margin: 0 0 1 0; }
.la-tool.run { border-color: $warn; }
.la-tool.ok { border-color: $ok; }
.la-tool.bad { border-color: $danger; }
.la-tool.warn { border-color: $warn; }
.la-tool-head { height: 1; gap: 1; }
.la-tool-mark, .la-tool-status, .la-tool-took { width: auto; }
.la-tool.ok > .la-tool-head > .la-tool-mark { color: $ok; bold: true; }
.la-tool.bad > .la-tool-head > .la-tool-mark { color: $danger; bold: true; }
.la-tool.warn > .la-tool-head > .la-tool-mark { color: $warn; bold: true; }

/* One row to eight (max-height counts the border), then it scrolls and shows a thumb. */
#composer { width: 1fr; max-height: 10; border: rounded; border-color: $border; padding: 0 1; scrollbar: auto; }
#composer:focus { border: double; border-color: $focus; }
.la-earlier { height: 1; color: $muted; }
.la-earlier:focus { color: $accent; }

#status { gap: 1; padding: 0 1; }
.la-statustext { width: auto; padding: 0 2 0 0; }
.la-hints { width: 1fr; justify: end; }
/* Narrow terminals: the context meter goes too (the mode and the locality
 * stay), and the status text is capped so at least the first hint (^P
 * commands) fits. Hints drop as a suffix: the first that does not fit
 * takes the rest. While an approval is open its status names the keys,
 * so it gets the whole row and the hints, which would repeat a and !, go:
 * capped, it cut `y allow` itself. It still ends in … where the row is
 * shorter than the keys (Esc deny at 60 columns). */
@media (max-cols: 60) {
  .la-ctx, .la-ctxbar, .la-grants { display: none; }
  .la-statustext { max-width: 50%; padding: 0; }
  .k-statusbar.approval-open > .la-statustext { max-width: 100%; }
  .k-statusbar.approval-open > .la-hints { display: none; }
}

/* The slash popup over the composer: a bordered panel like the palette's,
 * the chosen row filled like the palette's selected item. */
.la-slashpop { height: auto; layout: column; border: rounded; border-color: $border; background: $panel; padding: 0 1; }
.la-slash-rows { height: auto; layout: column; }
.la-slash-row { height: 1; gap: 1; }
.la-slash-row.sel { background: $accent; bold: true; }
.la-slash-row.sel > text { color: $on-accent; }
.la-slash-mark { width: 1; }
.la-slash-cmd { width: auto; bold: true; }
.la-slash-desc { width: 1fr; color: $muted; }
.la-slash-foot { color: $subtle; }
/* A sessions-picker row's label (the row itself is the slash popup's). */
.la-panel-label { width: 1fr; }
/* An ask_user question, in flow above the composer (both clients). */
.la-question { height: auto; layout: column; border: rounded; border-color: $accent; title-color: $accent; padding: 0 1; }
.la-question-text { width: 1fr; }
.la-question-rows { height: auto; layout: column; margin: 1 0 0 0; }
.la-question-label { width: auto; }

/* The help overlay's own rows (the commands section and the composer's
 * enter keys under the hints). */
/* No gap above a head (bold, in the accent colour, it reads as one): the
 * rows saved keep every command and key in view at 30 rows. */
.la-help-head { bold: true; color: $accent; margin: 0; }
/* The kit's help box pads a row above and below; /copy, the selection row and
 * ^Y copy each took one, so the padding and the merged enter row give them
 * back: the keys down to the history key stay in view at 80x30. */
.k-help { padding: 0 2; }
.la-help-first { margin: 0; }
.la-helpcmds { height: auto; layout: column; }
.la-helpcmd { width: 1fr; height: 1; gap: 1; }
.la-helpcmd-key { width: auto; bold: true; color: $accent; }
/* A key column wide enough for the longest key, "option-drag". */
.la-helpkey { width: 11; bold: true; color: $accent; }
.la-helpcmd-desc { width: 1fr; color: $muted; }

/* The details viewer modal: the kit help dialog's box at the approval
 * dialog's width (76), so the parent wraps its rows like a preview. The
 * read-only panel (/status, /mcp, /sessions) is the same box under its
 * own class, so its keys are its own. */
.la-details, .la-panel { width: 76; max-width: 100%; height: auto; max-height: 100%; padding: 1 2; border: rounded; background: $panel; border-color: $accent; title-color: $accent; }

.la-diff { max-height: 14; width: 1fr; height: auto; border: single; border-color: $border; scrollbar: auto; }
/* A very short terminal keeps the diff's last row instead of the grant
 * line (the status still names `a` there; the offer returns with height). */
@media (max-rows: 12) {
  .la-granthint { display: none; }
}
.la-diff:focus { border: double; border-color: $focus; }
.la-difflines { height: auto; layout: column; }
.la-difflines > text { height: 1; }
.add { color: $ok; }
.del { color: $danger; }
.note { color: $muted; italic: true; }
