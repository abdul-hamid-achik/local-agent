/* The inline document's own rules, loaded after app.tcss (which it shares
 * with the fullscreen client, so printed turns look the same). */

/* The region is as tall as its content: the fullscreen 1fr claim is undone. */
#app { height: auto; }
#liveregion { width: 1fr; height: auto; }

/* The in-flow approval. Its diff is capped, so a short terminal keeps the
 * composer and the status in view. */
.la-approve { height: auto; layout: column; border: rounded; border-color: $accent; title-color: $accent; padding: 0 1; margin: 0 0 1 0; }
.la-approve.danger { border-color: $danger; title-color: $danger; }
.la-approve-body { width: 1fr; }
.la-approve > .la-diff { max-height: 10; }
@media (max-rows: 20) {
  .la-approve > .la-diff { max-height: 5; }
}

/* The details viewer, in flow like the approval: its output scroll is
 * capped, so a short terminal keeps the composer and the status in view. */
.la-details-inline { height: auto; layout: column; border: rounded; border-color: $accent; title-color: $accent; padding: 0 1; margin: 0 0 1 0; }
.la-details-inline > .la-diff { max-height: 12; }
@media (max-rows: 20) {
  .la-details-inline > .la-diff { max-height: 6; }
}

/* While an approval is open the live card only repeats "waiting for
 * approval": its rows belong to the diff. */
screen.approving > #app > #liveregion { display: none; }

/* Blank room a kit modal is laid out against: the region does not grow for
 * a modal, so the document grows it while the modal is open. Each height is
 * its modal's in a tall terminal (k-palette is 16 rows; the help sizes to
 * its commands and keys, and check.ts fails when the two drift). A shorter
 * terminal gives the region all its rows, and the help's scroll takes what
 * is left. */
.la-space-palette { height: 16; }
.la-space-help { height: 39; }

/* A modal is centered on the region, so the region holds its spacer alone
 * while one is open: anything else would sit under the modal's edges. A
 * child added to #app joins both lists (check.ts dumps each modal over
 * every card the region can hold). A <use> passes no id to its template's
 * root, so the question card is matched by its class. */
screen.helping > #app > .k-appbar,
screen.helping > #app > #liveregion,
screen.helping > #app > #details,
screen.helping > #app > #panel,
screen.helping > #app > #approve,
screen.helping > #app > .la-question,
screen.helping > #app > #slashpop,
screen.helping > #app > #composer,
screen.helping > #app > #status,
screen.paletting > #app > .k-appbar,
screen.paletting > #app > #liveregion,
screen.paletting > #app > #details,
screen.paletting > #app > #panel,
screen.paletting > #app > #approve,
screen.paletting > #app > .la-question,
screen.paletting > #app > #slashpop,
screen.paletting > #app > #composer,
screen.paletting > #app > #status { display: none; }
/* A terminal shorter than the spacer gets all its rows, and the screen
 * cuts the blank rest of the spacer instead of warning that it does not fit. */
screen.helping, screen.paletting { overflow: hidden; }
