/*
 * themes/catppuccin-latte.tcss: a named palette adapted from Catppuccin
 * Latte (https://github.com/catppuccin/palette, MIT). Raised surfaces
 * are mantle; the selected one blends base toward surface0, kept near
 * base so the text colors keep as much of their own values as they can.
 *
 * Loaded last (after app.tcss) by the document --theme generates, so its
 * :root tokens re-declare the kit's and app.tcss's. Tokens only: no rules,
 * no @import. The host is pinned to dark for a named theme, so the light
 * variants of theme.tcss and app.tcss never fire; this palette carries
 * its own light values instead.
 *
 * Every text token reads at WCAG AA (4.5:1) on bg, panel, raised and
 * sel, and fg, muted and subtle stay a visible step apart on bg. To get
 * there, these source colors moved along their own hue:
 *   --muted   #5c5f77 -> #5b5e76  (subtext1)
 *   --subtle  #6c6f85 -> #62657b  (subtext0)
 *   --accent  #8839ef -> #8433ea  (mauve)
 *   --focus   #8839ef -> #8433ea  (mauve)
 *   --ok      #40a02b -> #1d7600  (green)
 *   --warn    #fe640b -> #b14200  (peach)
 *   --danger  #d20f39 -> #cd0035  (red)
 *   --info    #209fb5 -> #007081  (sapphire)
 *   --code    #ea76cb -> #a9398e  (pink)
 *   --kw      #8839ef -> #8433ea  (mauve)
 *   --str     #40a02b -> #1d7600  (green)
 *   --num     #fe640b -> #b14200  (peach)
 *   --com     #7c7f93 -> #626578  (overlay2)
 *   --user    #179299 -> #007177  (teal)
 *   --tool    #df8e1d -> #925900  (yellow)
 */
:root {
  --bg: #eff1f5;
  --fg: #4c4f69;
  --muted: #5b5e76;
  --subtle: #62657b;
  --border: #bcc0cc;
  --panel: #e6e9ef;
  --raised: #e6e9ef;
  --accent: #8433ea;
  --focus: #8433ea;
  --ok: #1d7600;
  --warn: #b14200;
  --danger: #cd0035;
  --info: #007081;
  --sel: #e3e5ec;
  --on-accent: #eff1f5;
  --on-ok: #eff1f5;
  --on-warn: #eff1f5;
  --on-danger: #eff1f5;
  --code: #a9398e;

  --kw: #8433ea;
  --str: #1d7600;
  --num: #b14200;
  --com: #626578;
  --user: #007177;
  --tool: #925900;
}
