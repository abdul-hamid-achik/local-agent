/*
 * themes/sepia.tcss: a named palette, loaded last (after app.tcss) by the
 * document --theme generates, so its :root tokens re-declare the kit's and
 * app.tcss's and rebrand the whole client. Tokens only: no rules, no @import.
 * The host is pinned to dark for a named theme, so the light variants of
 * theme.tcss and app.tcss never fire against it; this palette carries its
 * own light values instead.
 */
:root {
  --bg: #f4ecd8;
  --fg: #43372a;
  --muted: #5b4f40;
  --subtle: #635746;
  --border: #d8c9a8;
  --panel: #ede1c6;
  --raised: #e3d5b3;
  --accent: #87482d;
  --focus: #8c4a2f;
  --ok: #3a6146;
  --warn: #775107;
  --danger: #9b3828;
  --info: #306065;
  --sel: #e0d0ab;
  --on-accent: #f4ecd8;
  --on-ok: #f4ecd8;
  --on-warn: #f4ecd8;
  --on-danger: #f4ecd8;
  --code: #77502f;

  --kw: #863023;
  --str: #4f5e28;
  --num: #7a4a1f;
  --com: #635746;
  --user: #3a6146;
  --tool: #775107;
}
