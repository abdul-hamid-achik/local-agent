/*
 * themes/rose-pine.tcss: a named palette adapted from Rosé Pine
 * (https://github.com/rose-pine/neovim, MIT). Its subtle is brighter than
 * its muted, so they swap here: the client's muted outranks its subtle.
 *
 * Loaded last (after app.tcss) by the document --theme generates, so its
 * :root tokens re-declare the kit's and app.tcss's. Tokens only: no rules,
 * no @import. The host is pinned to dark for a named theme.
 *
 * Every text token reads at WCAG AA (4.5:1) on bg, panel, raised and
 * sel, and fg, muted and subtle stay a visible step apart on bg. To get
 * there, these source colors moved along their own hue:
 *   --muted   #908caa -> #9692b0  (subtle)
 *   --subtle  #6e6a86 -> #8e8aa7  (muted)
 *   --ok      #31748f -> #5395b1  (pine)
 *   --kw      #31748f -> #5395b1  (pine)
 *   --com     #6e6a86 -> #8e8aa7  (muted)
 */
:root {
  --bg: #191724;
  --fg: #e0def4;
  --muted: #9692b0;
  --subtle: #8e8aa7;
  --border: #403d52;
  --panel: #1f1d2e;
  --raised: #26233a;
  --accent: #c4a7e7;
  --focus: #c4a7e7;
  --ok: #5395b1;
  --warn: #f6c177;
  --danger: #eb6f92;
  --info: #9ccfd8;
  --sel: #21202e;
  --on-accent: #191724;
  --on-ok: #191724;
  --on-warn: #191724;
  --on-danger: #191724;
  --code: #ebbcba;

  --kw: #5395b1;
  --str: #f6c177;
  --num: #c4a7e7;
  --com: #8e8aa7;
  --user: #9ccfd8;
  --tool: #f6c177;
}
