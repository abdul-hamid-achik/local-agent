      {
        "id": "/model",
        "cmd": "/model [NAME]",
        "desc": "show or switch the Ollama model"
      },
      {
        "id": "/theme",
        "cmd": "/theme dark|light|auto",
        "desc": "set the session theme"
      },
      {
        "id": "/mouse",
        "cmd": "/mouse on|off",
        "desc": "toggle mouse reporting (fullscreen)"
      },
      {
        "id": "/permissions",
        "cmd": "/permissions [clear|trust]",
        "desc": "show, clear or trust grants and rules"
      },
      {
        "id": "/sandbox",
        "cmd": "/sandbox on|off",
        "desc": "run commands confined (macOS), without a card"
      },
      {
        "id": "/details",
        "cmd": "/details",
        "desc": "show the last tool output in full"
      },
      {
        "id": "/status",
        "cmd": "/status",
        "desc": "show the effective config (model, workspace, session)"
      },
      {
        "id": "/provider",
        "cmd": "/provider",
        "desc": "ask the model's endpoint: answer time, what is loaded"
      },
      {
        "id": "/sessions",
        "cmd": "/sessions [new]",
        "desc": "switch to a saved session, or start a new one"
      },
      {
        "id": "/recover",
        "cmd": "/recover [N outcome]",
        "desc": "review calls whose outcome is unknown"
      },
      {
        "id": "/find",
        "cmd": "/find TEXT",
        "desc": "search saved session messages (needs --session-db)"
      },
      {
        "id": "/export",
        "cmd": "/export [json]",
        "desc": "write the conversation to a markdown or JSON file"
      },
      {
        "id": "/mcp",
        "cmd": "/mcp",
        "desc": "show connected MCP servers and their tools"
      },
      {
        "id": "/goal",
        "cmd": "/goal [OBJECTIVE|stop]",
        "desc": "run turns toward an objective until done or a limit"
      }
