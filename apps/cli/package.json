{
  "name": "@local-agent/cli",
  "version": "0.50.0",
  "private": true,
  "type": "module",
  "bin": {
    "local-agent": "./launcher.ts"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --splitting --outdir=dist --entry-naming=main.mjs"
  },
  "dependencies": {
    "@local-agent/runtime": "workspace:*",
    "@local-agent/vue-tui": "workspace:*",
    "@thelacanians/tuimark": "0.5.1",
    "vue": "3.5.44"
  },
  "imports": {
    "#cli/*": "./src/*.ts"
  }
}
